/* artifacts.js — Right-side panel for renderable chat artifacts (md/html/svg).
 *
 * Backend: lib/artifacts/* persists each artifact to the chat_artifacts
 * table.  Producers (currently: write_file post-hook in
 * lib/tasks_pkg/handlers/project.py) call create_artifact + emit a
 * metadata-only "artifact" SSE event.  This module:
 *
 *   1. Listens for the SSE event handler (wired in ui.js) which calls
 *      Artifacts.attachToMessage(msg, artifactMeta) to stash metadata on
 *      the live assistant message.
 *   2. Renders a chip near the message tool-round panel — clicking opens
 *      this panel.
 *   3. Fetches /api/artifacts/<id>/raw lazily on open and renders it:
 *        markdown → renderMarkdown() (DOMPurify-cleaned, see core.js)
 *        html     → <iframe sandbox srcdoc>  (NO scripts by default)
 *        svg      → <iframe sandbox srcdoc>  (forced when <script> present)
 *
 * Security invariants — see lib/artifacts/__init__.py and routes/artifacts.py.
 *   • NEVER innerHTML model HTML into the main document.
 *   • Iframe must NOT have allow-scripts unless the user explicitly opts in
 *     (and we then drop allow-same-origin to keep the spec-safe combo).
 *   • The /raw endpoint already ships a strict CSP — this is defense in depth.
 */

(function () {
  "use strict";

  // ── Module state ────────────────────────────────────────────────────
  // Conv-scoped cache of metadata + content.  Keyed by artifact id.
  // Content fetched lazily on first open; subsequent opens are instant.
  const _metaCache = new Map();    // id → meta dict
  const _contentCache = new Map(); // id → raw string

  // The currently open artifact (if any), so SSE updates can refresh.
  let _activeId = null;

  // Per-session script-allow consent (NOT persisted).
  // Map<id, true>  — present means user clicked "Allow scripts".
  const _scriptsAllowed = new Set();

  // ── DOM helpers ─────────────────────────────────────────────────────

  function _ensurePanel() {
    let panel = document.getElementById("artifact-panel");
    if (panel) return panel;

    panel = document.createElement("aside");
    panel.id = "artifact-panel";
    panel.className = "artifact-panel artifact-panel-hidden";
    panel.setAttribute("aria-hidden", "true");
    panel.innerHTML =
      '<div class="artifact-panel-header">' +
        '<div class="artifact-panel-title-wrap">' +
          '<span class="artifact-panel-format-badge" data-art-format></span>' +
          '<span class="artifact-panel-title" data-art-title></span>' +
        '</div>' +
        '<div class="artifact-panel-actions">' +
          '<button class="artifact-btn" data-art-action="toggle-source" title="Toggle source view">⌷</button>' +
          '<button class="artifact-btn" data-art-action="copy" title="Copy source">⧉</button>' +
          '<button class="artifact-btn" data-art-action="download" title="Download">⬇</button>' +
          '<button class="artifact-btn" data-art-action="pin" title="Pin">☆</button>' +
          '<button class="artifact-btn artifact-btn-close" data-art-action="close" title="Close">✕</button>' +
        '</div>' +
      '</div>' +
      '<div class="artifact-panel-banner" data-art-banner hidden></div>' +
      '<div class="artifact-panel-body" data-art-body></div>';
    document.body.appendChild(panel);

    panel.addEventListener("click", _onPanelClick);
    return panel;
  }

  function _onPanelClick(e) {
    const btn = e.target.closest("[data-art-action]");
    if (!btn) return;
    const action = btn.getAttribute("data-art-action");
    if (action === "close") {
      closePanel();
    } else if (action === "copy") {
      _copySource();
    } else if (action === "download") {
      _download();
    } else if (action === "pin") {
      _togglePin();
    } else if (action === "toggle-source") {
      _toggleSourceView();
    } else if (action === "allow-scripts") {
      _allowScripts();
    }
  }

  // ── Open / close ────────────────────────────────────────────────────

  /**
   * Open an artifact in the right-side panel by id.  Fetches metadata +
   * raw content on demand; subsequent opens hit cache.
   */
  async function open(id) {
    if (!id) return;
    const panel = _ensurePanel();
    _activeId = id;

    // Reveal the panel + adjust layout immediately so the user gets feedback.
    panel.classList.remove("artifact-panel-hidden");
    panel.setAttribute("aria-hidden", "false");
    document.body.classList.add("artifact-panel-open");

    const titleEl = panel.querySelector("[data-art-title]");
    const fmtEl   = panel.querySelector("[data-art-format]");
    const bodyEl  = panel.querySelector("[data-art-body]");
    if (titleEl) titleEl.textContent = "Loading…";
    if (fmtEl) fmtEl.textContent = "";
    if (bodyEl) bodyEl.innerHTML = '<div class="artifact-loading">Loading artifact…</div>';

    try {
      const meta = await _ensureMeta(id);
      if (_activeId !== id) return;  // user opened something else
      _renderHeader(panel, meta);

      const content = await _ensureContent(id);
      if (_activeId !== id) return;
      _renderBody(panel, meta, content, /*sourceView=*/ false);
    } catch (err) {
      console.warn("[Artifacts] open failed:", err);
      if (bodyEl) {
        bodyEl.innerHTML =
          '<div class="artifact-error">Failed to load artifact: ' +
          (typeof escapeHtml === "function" ? escapeHtml(String(err)) : String(err)) +
          '</div>';
      }
    }
  }

  function closePanel() {
    const panel = document.getElementById("artifact-panel");
    if (!panel) return;
    panel.classList.add("artifact-panel-hidden");
    panel.setAttribute("aria-hidden", "true");
    document.body.classList.remove("artifact-panel-open");
    _activeId = null;
  }

  // ── Fetch helpers ───────────────────────────────────────────────────

  async function _ensureMeta(id) {
    if (_metaCache.has(id)) return _metaCache.get(id);
    const url = (typeof apiUrl === "function" ? apiUrl("/api/artifacts/" + id) : "/api/artifacts/" + id);
    const resp = await fetch(url);
    if (!resp.ok) throw new Error("HTTP " + resp.status);
    const meta = await resp.json();
    _metaCache.set(id, meta);
    return meta;
  }

  async function _ensureContent(id) {
    if (_contentCache.has(id)) return _contentCache.get(id);
    const url = (typeof apiUrl === "function" ? apiUrl("/api/artifacts/" + id + "/raw") : "/api/artifacts/" + id + "/raw");
    const resp = await fetch(url);
    if (!resp.ok) throw new Error("HTTP " + resp.status);
    const text = await resp.text();
    _contentCache.set(id, text);
    return text;
  }

  // ── Rendering ───────────────────────────────────────────────────────

  function _renderHeader(panel, meta) {
    const titleEl = panel.querySelector("[data-art-title]");
    const fmtEl   = panel.querySelector("[data-art-format]");
    if (titleEl) titleEl.textContent = meta.title || meta.id.slice(0, 8);
    if (fmtEl) {
      fmtEl.textContent = meta.format || "";
      fmtEl.dataset.format = meta.format || "";
    }
    const pinBtn = panel.querySelector('[data-art-action="pin"]');
    if (pinBtn) pinBtn.textContent = meta.pinned ? "★" : "☆";
  }

  function _renderBody(panel, meta, content, sourceView) {
    const bodyEl = panel.querySelector("[data-art-body]");
    const banner = panel.querySelector("[data-art-banner]");
    if (!bodyEl) return;

    // Reset state from previous artifact
    if (banner) {
      banner.hidden = true;
      banner.innerHTML = "";
    }
    bodyEl.innerHTML = "";
    bodyEl.dataset.sourceView = sourceView ? "1" : "0";

    if (sourceView) {
      const pre = document.createElement("pre");
      pre.className = "artifact-source-view";
      pre.textContent = content;
      bodyEl.appendChild(pre);
      return;
    }

    const fmt = meta.format;
    if (fmt === "markdown") {
      _renderMarkdown(bodyEl, content);
    } else if (fmt === "html") {
      _renderHtml(panel, banner, bodyEl, meta, content);
    } else if (fmt === "svg") {
      _renderSvg(panel, banner, bodyEl, meta, content);
    } else {
      const pre = document.createElement("pre");
      pre.className = "artifact-source-view";
      pre.textContent = content;
      bodyEl.appendChild(pre);
    }
  }

  function _renderMarkdown(bodyEl, content) {
    // renderMarkdown (core.js:2906) already runs DOMPurify.sanitize on the
    // marked.parse output, so it's safe to inject as HTML.
    let html;
    try {
      html = (typeof renderMarkdown === "function")
        ? renderMarkdown(content)
        : (typeof escapeHtml === "function" ? "<pre>" + escapeHtml(content) + "</pre>"
                                            : "<pre>" + content + "</pre>");
    } catch (e) {
      console.warn("[Artifacts] renderMarkdown failed, falling back to escapeHtml:", e);
      html = (typeof escapeHtml === "function" ? "<pre>" + escapeHtml(content) + "</pre>"
                                                : "<pre>" + content + "</pre>");
    }
    const wrap = document.createElement("div");
    wrap.className = "artifact-md md-content";
    wrap.innerHTML = html;
    bodyEl.appendChild(wrap);
  }

  function _renderHtml(panel, banner, bodyEl, meta, content) {
    const allowScripts = _scriptsAllowed.has(meta.id);
    const hasScripts = /<script[\s>]/i.test(content);

    if (hasScripts && !allowScripts && banner) {
      banner.hidden = false;
      banner.innerHTML =
        '<span class="artifact-banner-icon">⚠</span>' +
        '<span class="artifact-banner-text">This document contains scripts. They are <strong>blocked</strong> by default.</span>' +
        '<button class="artifact-btn artifact-btn-allow" data-art-action="allow-scripts">Allow scripts (this session)</button>';
    }

    const iframe = document.createElement("iframe");
    iframe.className = "artifact-iframe";
    // Spec-safe sandbox combos:
    //   default            → sandbox (no allow-*) — fully isolated, no scripts
    //   user opted in      → sandbox="allow-scripts" — runs JS, but iframe is
    //                        treated as opaque origin, so it can't reach
    //                        parent.localStorage / cookies / etc.
    iframe.setAttribute(
      "sandbox",
      allowScripts ? "allow-scripts" : ""
    );
    iframe.setAttribute("referrerpolicy", "no-referrer");
    iframe.setAttribute("loading", "lazy");
    iframe.srcdoc = content;
    bodyEl.appendChild(iframe);
  }

  function _renderSvg(panel, banner, bodyEl, meta, content) {
    const hasScripts = /<script[\s>]/i.test(content);
    if (hasScripts) {
      // Re-use the HTML path to get the same script-block consent flow.
      _renderHtml(panel, banner, bodyEl, meta, content);
      return;
    }
    // Static SVG — render as an <img> via data: URL (sandboxed by browser).
    const wrap = document.createElement("div");
    wrap.className = "artifact-svg";
    const img = document.createElement("img");
    img.alt = meta.title || "SVG artifact";
    img.src = "data:image/svg+xml;utf8," + encodeURIComponent(content);
    wrap.appendChild(img);
    bodyEl.appendChild(wrap);
  }

  // ── Header actions ──────────────────────────────────────────────────

  async function _copySource() {
    if (!_activeId) return;
    try {
      const text = await _ensureContent(_activeId);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        // Fallback: temp textarea
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      if (typeof showToast === "function") {
        showToast("", "Copied", "Artifact source copied to clipboard.", 2000);
      }
    } catch (e) {
      console.warn("[Artifacts] copy failed:", e);
    }
  }

  async function _download() {
    if (!_activeId) return;
    try {
      const meta = await _ensureMeta(_activeId);
      const text = await _ensureContent(_activeId);
      const ext = meta.format === "html" ? "html"
                : meta.format === "svg" ? "svg"
                : "md";
      const fname = (meta.title && /\.\w+$/.test(meta.title))
        ? meta.title
        : (meta.title || "artifact-" + meta.id.slice(0, 8)) + "." + ext;
      const mime = meta.format === "html" ? "text/html"
                 : meta.format === "svg" ? "image/svg+xml"
                 : "text/markdown";
      const blob = new Blob([text], { type: mime + ";charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = fname;
      a.style.display = "none";
      document.body.appendChild(a);
      a.click();
      a.remove();
      // Revoke after a short delay so the download has time to start.
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
    } catch (e) {
      console.warn("[Artifacts] download failed:", e);
    }
  }

  async function _togglePin() {
    if (!_activeId) return;
    try {
      const meta = await _ensureMeta(_activeId);
      const next = !meta.pinned;
      const url = (typeof apiUrl === "function" ? apiUrl("/api/artifacts/" + _activeId + "/pin") : "/api/artifacts/" + _activeId + "/pin");
      const resp = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pinned: next }),
      });
      if (!resp.ok) throw new Error("HTTP " + resp.status);
      const updated = await resp.json();
      _metaCache.set(_activeId, updated);
      const panel = document.getElementById("artifact-panel");
      if (panel) _renderHeader(panel, updated);
    } catch (e) {
      console.warn("[Artifacts] pin failed:", e);
    }
  }

  async function _toggleSourceView() {
    if (!_activeId) return;
    const panel = document.getElementById("artifact-panel");
    if (!panel) return;
    const bodyEl = panel.querySelector("[data-art-body]");
    const cur = (bodyEl && bodyEl.dataset.sourceView === "1");
    const meta = await _ensureMeta(_activeId);
    const content = await _ensureContent(_activeId);
    _renderBody(panel, meta, content, /*sourceView=*/ !cur);
  }

  function _allowScripts() {
    if (!_activeId) return;
    _scriptsAllowed.add(_activeId);
    // Audit: best-effort, fire and forget.
    try {
      const url = (typeof apiUrl === "function" ? apiUrl("/api/client-error") : "/api/client-error");
      fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: "[debugLog][info] artifact_scripts_allowed id=" + _activeId,
          url: location.href,
          extra: { artifactId: _activeId },
        }),
      }).catch(function (e) {
        console.debug("[Artifacts] consent log post failed:", e);
      });
    } catch (e) {
      console.debug("[Artifacts] consent log build failed:", e);
    }
    // Re-render the body, this time with allow-scripts.
    open(_activeId);
  }

  // ── Public API: chip rendering hook called by ui.js ─────────────────

  /**
   * Stash an artifact metadata dict on a live message so subsequent
   * renderChat() invocations include the chip.  Meant to be called from
   * the ui.js SSE handler for ev.type === "artifact".
   *
   * msg may be undefined (off-screen task) — caller should still update
   * the panel cache so a later "open by id" works.
   */
  function attachToMessage(msg, meta) {
    if (!meta || !meta.id) return;
    _metaCache.set(meta.id, meta);
    if (!msg) return;
    if (!Array.isArray(msg._artifacts)) msg._artifacts = [];
    // Dedupe by id; if id already present, replace (newer version metadata).
    const existingIdx = msg._artifacts.findIndex(function (a) { return a && a.id === meta.id; });
    if (existingIdx >= 0) {
      msg._artifacts[existingIdx] = meta;
    } else {
      msg._artifacts.push(meta);
    }
  }

  /**
   * Render an HTML chip strip for a list of artifact metadata.  Called
   * from ui.js's per-message render path.  Empty string when no artifacts.
   */
  function renderChips(artifacts) {
    if (!Array.isArray(artifacts) || artifacts.length === 0) return "";
    const _esc = (typeof escapeHtml === "function") ? escapeHtml : function (s) { return String(s); };
    const items = artifacts.map(function (a) {
      const id   = _esc(a.id || "");
      const fmt  = _esc(a.format || "?");
      const title = _esc(a.title || (a.id ? ("artifact-" + a.id.slice(0, 8)) : "artifact"));
      const sz   = a.size_bytes ? _formatBytes(a.size_bytes) : "";
      const fmtIcon = (a.format === "html") ? "🌐"
                    : (a.format === "svg")  ? "🖼"
                    : "📄";
      return (
        '<button class="artifact-chip artifact-chip-' + fmt + '" ' +
        'data-artifact-id="' + id + '" ' +
        'onclick="event.stopPropagation();Artifacts.open(\'' + id + '\')" ' +
        'title="Open ' + title + ' in artifact panel">' +
          '<span class="artifact-chip-icon">' + fmtIcon + '</span>' +
          '<span class="artifact-chip-title">' + title + '</span>' +
          (sz ? '<span class="artifact-chip-size">' + _esc(sz) + '</span>' : '') +
          '<span class="artifact-chip-cta">Open</span>' +
        '</button>'
      );
    }).join("");
    return '<div class="artifact-chip-row">' + items + '</div>';
  }

  function _formatBytes(n) {
    if (!Number.isFinite(n) || n <= 0) return "";
    if (n < 1024) return n + " B";
    if (n < 1024 * 1024) return Math.round(n / 1024) + " KB";
    return (n / (1024 * 1024)).toFixed(1) + " MB";
  }

  // ── Hydration: pull all artifacts for a conversation, attach to msgs ─

  /**
   * Fetch /api/artifacts/conv/<conv_id> and attach each row to the
   * matching assistant message via msg_id (or trailing one as fallback).
   * Idempotent — safe to call on every conversation load.
   */
  async function hydrateConversation(conv) {
    if (!conv || !conv.id) return;
    try {
      const url = (typeof apiUrl === "function" ? apiUrl("/api/artifacts/conv/" + conv.id) : "/api/artifacts/conv/" + conv.id);
      const resp = await fetch(url);
      if (!resp.ok) return;
      const payload = await resp.json();
      const rows = payload && payload.artifacts;
      if (!Array.isArray(rows) || rows.length === 0) return;

      // Build msg_id → message map for fast lookup.
      const byMsgId = new Map();
      for (const m of conv.messages || []) {
        const mid = m && m._msgId;
        if (mid) byMsgId.set(mid, m);
      }
      // Find the last assistant message as fallback for legacy rows
      // missing msg_id.
      let lastAssistant = null;
      for (let i = (conv.messages || []).length - 1; i >= 0; i--) {
        if (conv.messages[i].role === "assistant") {
          lastAssistant = conv.messages[i];
          break;
        }
      }

      for (const meta of rows) {
        _metaCache.set(meta.id, meta);
        const target = (meta.msg_id && byMsgId.get(meta.msg_id)) || lastAssistant;
        if (target) attachToMessage(target, meta);
      }
    } catch (e) {
      console.debug("[Artifacts] hydrateConversation failed:", e);
    }
  }

  // ── Keyboard: Esc closes the panel ──────────────────────────────────
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && _activeId) {
      closePanel();
    }
  });

  // ── Public façade ──────────────────────────────────────────────────
  window.Artifacts = {
    open: open,
    closePanel: closePanel,
    attachToMessage: attachToMessage,
    renderChips: renderChips,
    hydrateConversation: hydrateConversation,
    // Exposed for tests / debug
    _meta: _metaCache,
    _content: _contentCache,
  };
})();
