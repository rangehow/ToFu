"""routes/api_v1/agents.py — Higher-level agent endpoints.

Exposes paper-report, translate, memory, browser-fetch, image-gen, and
swarm under a uniform v1 shape with proper scopes. All actual logic
lives in the existing modules — these routes are stable façades so
external callers don't depend on legacy paths.
"""

from __future__ import annotations

from flask import Blueprint, request

from lib.api_response import api_bad_request, api_internal_error, api_not_found, api_ok
from lib.log import get_logger
from lib.openapi import api_meta
from lib.request_parser import optional_str, parse_body, require_str

from .auth import require_scope

logger = get_logger(__name__)

api_v1_agents_bp = Blueprint('api_v1_agents', __name__)


# ── Paper ───────────────────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/paper/report', methods=['POST'])
@require_scope('agents:paper')
@api_meta(summary='Start a paper-report task', tags=['agents'],
          scope='agents:paper')
def paper_report_start():
    try:
        from routes.paper import start_report_task
    except Exception as e:
        return api_internal_error(f'Paper module unavailable: {e}')
    return start_report_task()


@api_v1_agents_bp.route('/api/v1/agents/paper/translate', methods=['POST'])
@require_scope('agents:paper')
@api_meta(summary='Start a paper-translate task', tags=['agents'],
          scope='agents:paper')
def paper_translate_start():
    try:
        from routes.paper import start_translate_task
    except Exception as e:
        return api_internal_error(f'Paper module unavailable: {e}')
    return start_translate_task()


# ── Translate ──────────────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/translate', methods=['POST'])
@require_scope('agents:translate')
@api_meta(summary='Start a translation task', tags=['agents'],
          scope='agents:translate',
          request_body={'required': True, 'content': {'application/json': {
              'schema': {'type': 'object',
                          'required': ['text'],
                          'properties': {
                              'text': {'type': 'string'},
                              'source_lang': {'type': 'string'},
                              'target_lang': {'type': 'string',
                                               'default': 'zh'},
                              'model': {'type': 'string'},
                          }}}}})
def translate_start():
    body = parse_body()
    try:
        require_str(body, 'text')
    except Exception as e:
        return api_bad_request(str(e), field='text')
    try:
        from routes import translate as _tr
    except Exception as e:
        return api_internal_error(f'Translate module unavailable: {e}')
    if hasattr(_tr, 'translate_start'):
        return _tr.translate_start()
    return api_not_found('Translate endpoint not registered')


# ── Memory ──────────────────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/memory/search', methods=['POST'])
@require_scope('agents:memory')
@api_meta(summary='Search memories', tags=['agents'],
          scope='agents:memory')
def memory_search():
    body = parse_body()
    query = optional_str(body, 'query', default='', max_len=500)
    if not query:
        return api_bad_request('query is required', field='query')
    try:
        from lib.memory import search_memories
    except Exception as e:
        return api_internal_error(f'Memory unavailable: {e}')
    try:
        top_k = int(body.get('top_k') or 30)
    except (ValueError, TypeError):
        top_k = 30
    try:
        results = search_memories(query, top_k=top_k)
    except Exception as e:
        logger.exception('[api_v1.memory] search failed')
        return api_internal_error(e)
    return api_ok(results=results, count=len(results))


# ── Browser fetch ──────────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/browser/fetch', methods=['POST'])
@require_scope('agents:browser')
@api_meta(summary='Fetch a URL via the server-side browser pipeline',
          tags=['agents'], scope='agents:browser')
def browser_fetch():
    body = parse_body()
    try:
        url = require_str(body, 'url', max_len=2000)
    except Exception as e:
        return api_bad_request(str(e), field='url')
    try:
        from lib.fetch import fetch_url
    except Exception as e:
        return api_internal_error(f'Fetch pipeline unavailable: {e}')
    try:
        text = fetch_url(url)
    except Exception as e:
        logger.warning('[api_v1.browser] fetch failed: %s', e)
        return api_internal_error(e)
    return api_ok(url=url, text=text or '', length=len(text or ''))


# ── Image generation ───────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/image-gen', methods=['POST'])
@require_scope('agents:image')
@api_meta(summary='Generate an image (delegates to the image-gen tool)',
          tags=['agents'], scope='agents:image',
          request_body={'required': True, 'content': {'application/json': {
              'schema': {'type': 'object',
                          'required': ['prompt'],
                          'properties': {
                              'prompt': {'type': 'string'},
                              'model': {'type': 'string'},
                              'size': {'type': 'string'},
                          }}}}})
def image_gen():
    body = parse_body()
    try:
        prompt = require_str(body, 'prompt', max_len=4000)
    except Exception as e:
        return api_bad_request(str(e), field='prompt')
    try:
        from lib.tools.image_gen import generate_image
    except Exception as e:
        return api_internal_error(f'Image-gen unavailable: {e}')
    try:
        out = generate_image(prompt=prompt,
                              model=body.get('model') or '',
                              size=body.get('size') or '1024x1024')
    except Exception as e:
        logger.exception('[api_v1.image-gen] failed')
        return api_internal_error(e)
    return api_ok(out)


# ── Swarm ──────────────────────────────────────────────────────────

@api_v1_agents_bp.route('/api/v1/agents/swarm/run', methods=['POST'])
@require_scope('agents:swarm')
@api_meta(summary='Start a swarm orchestration', tags=['agents'],
          scope='agents:swarm')
def swarm_run():
    try:
        from routes import swarm as _sw
    except Exception as e:
        return api_internal_error(f'Swarm unavailable: {e}')
    if hasattr(_sw, 'swarm_start'):
        return _sw.swarm_start()
    return api_not_found('Swarm endpoint not registered')


__all__ = ['api_v1_agents_bp']
