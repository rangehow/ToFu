[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "github-batch-mcp"
version = "0.1.0"
description = "Fast batch-commit MCP server for GitHub — O(1) API calls regardless of file count"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }
dependencies = [
    "mcp>=1.0.0",
    "httpx>=0.27.0",
]

[project.scripts]
github-batch-mcp = "github_batch_mcp.server:main"

[tool.hatch.build.targets.wheel]
packages = ["github_batch_mcp"]
