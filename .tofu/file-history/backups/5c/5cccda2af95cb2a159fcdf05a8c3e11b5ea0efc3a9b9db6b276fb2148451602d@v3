@pytest.mark.unit
class TestBridgeCors:
    """B3: /api/browser/* must NOT echo Access-Control-Allow-Origin: *.

    Chrome extensions reach the server via host_permissions, which does
    not require server-sent CORS headers. Dropping the wildcard removes
    a defence-in-depth gap (any cross-origin page could probe the bridge
    when the gate is unset, e.g. on LAN deployments).
    """

    def test_no_wildcard_origin_on_status(self, flask_client):
        resp = flask_client.get('/api/browser/status')
        assert resp.headers.get('Access-Control-Allow-Origin') != '*'

    def test_no_wildcard_origin_on_poll(self, flask_client, monkeypatch):
        monkeypatch.delenv('TOFU_BRIDGE_SECRET', raising=False)
        monkeypatch.delenv('CHATUI_BRIDGE_SECRET', raising=False)
        resp = flask_client.post('/api/browser/poll', json={'results': []})
        assert resp.headers.get('Access-Control-Allow-Origin') != '*'

    def test_no_wildcard_origin_on_options_preflight(self, flask_client):
        resp = flask_client.options('/api/browser/poll')
        assert resp.headers.get('Access-Control-Allow-Origin') != '*'


@pytest.mark.unit
class TestBridgeAuthInternals:
    """Hot-reload + timing-safe compare contracts."""

    def test_uses_hmac_compare_digest(self):
        """Constant-time compare prevents header timing oracles."""
        import inspect

        from routes import browser as browser_mod
        from routes import desktop as desktop_mod
        for mod in (browser_mod, desktop_mod):
            src = inspect.getsource(mod._check_bridge_auth)
            assert 'hmac.compare_digest' in src, (
                f'{mod.__name__}._check_bridge_auth must use hmac.compare_digest, '
                f'not == comparison (header timing oracle).'
            )

    def test_secret_read_at_call_time(self, flask_client, monkeypatch):
        """Hot-reload: changing the env between requests must take effect.

        Mirrors the lib.proxy / lib.config_dir hot-reload contract.
        """
        # First request: no secret set, allowed.
        monkeypatch.delenv('TOFU_BRIDGE_SECRET', raising=False)
        monkeypatch.delenv('CHATUI_BRIDGE_SECRET', raising=False)
        r1 = flask_client.post('/api/desktop/poll', json={'results': []})
        assert r1.status_code == 200
        # Now set the secret without restarting; next request must be gated.
        monkeypatch.setenv('TOFU_BRIDGE_SECRET', 'fresh-secret')
        r2 = flask_client.post('/api/desktop/poll', json={'results': []})
        assert r2.status_code == 401
