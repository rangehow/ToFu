    if (_paperParsedText || _paperHash) {
      _loadOrGenerateReport();
    } else {
      var _empty = document.getElementById('paperReportContent');
      if (_empty) {
        _empty.innerHTML = '<div class="paper-report-empty"><p>No paper text available. Load a PDF first.</p></div>';
