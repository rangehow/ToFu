"""tests/test_idempotency.py — Idempotency-Key cache behaviour."""

import unittest
from unittest.mock import MagicMock, patch


class IdempotencyTest(unittest.TestCase):

    def setUp(self):
        from lib.idempotency import _cache
        _cache.clear()

    def test_no_header_passes_through(self):
        from lib.idempotency import idempotent_post

        calls = []
        @idempotent_post()
        def handler():
            calls.append(1)
            return ({'ok': True, 'value': len(calls)}, 200)

        with patch('lib.idempotency.request') as req:
            req.headers.get.return_value = ''
            r1 = handler()
            r2 = handler()
            self.assertEqual(r1[0]['value'], 1)
            self.assertEqual(r2[0]['value'], 2)
            self.assertEqual(len(calls), 2)

    def test_replay_same_key_returns_cached(self):
        from lib.idempotency import idempotent_post

        calls = []
        @idempotent_post()
        def handler():
            calls.append(1)
            return ({'ok': True, 'value': len(calls)}, 200)

        # First call: key=abc → run handler, cache.
        # Second call: key=abc → cache hit, no handler invocation.
        with patch('lib.idempotency.request') as req:
            req.headers.get.return_value = 'abc'
            with patch('lib.idempotency._cache_key',
                        return_value='_:abc'):
                r1 = handler()
                r2 = handler()
        self.assertEqual(len(calls), 1)
        # Both responses carry the same value (cached).
        # r2 is a Flask response, so unwrap by inspecting via _serialise/_replay
        # — instead just verify only ONE invocation happened.

    def test_different_keys_rerun(self):
        from lib.idempotency import idempotent_post

        calls = []
        @idempotent_post()
        def handler():
            calls.append(1)
            return ({'ok': True}, 200)

        with patch('lib.idempotency.request') as req:
            req.headers.get.side_effect = ['k1', 'k2']
            with patch('lib.idempotency._cache_key',
                        side_effect=['_:k1', '_:k2']):
                handler()
                handler()
        self.assertEqual(len(calls), 2)

    def test_error_status_not_cached(self):
        from lib.idempotency import idempotent_post

        calls = []
        @idempotent_post()
        def handler():
            calls.append(1)
            # Always returns a 4xx — should NOT be cached.
            return ({'ok': False, 'error': 'bad'}, 400)

        with patch('lib.idempotency.request') as req:
            req.headers.get.return_value = 'errkey'
            with patch('lib.idempotency._cache_key',
                        return_value='_:errkey'):
                handler()
                handler()
        self.assertEqual(len(calls), 2)


if __name__ == '__main__':
    unittest.main()
