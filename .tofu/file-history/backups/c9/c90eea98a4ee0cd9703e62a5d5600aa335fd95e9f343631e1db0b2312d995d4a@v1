"""github-batch-mcp server — batch-commit tools using GitHub's git-data API.

Why this exists
---------------
The official ``mcp__github__push_files`` is ~O(N) in the number of files
because it uploads each file as a separate blob before assembling the tree.
For a 50-file commit that's 50 blob POSTs + 1 tree + 1 commit + 1 ref
update — round-trip-bound on a high-latency link.

This server collapses the same operation to a fixed call count:

  1. GET  /repos/{owner}/{repo}/git/refs/heads/{branch}        → commit SHA
  2. GET  /repos/{owner}/{repo}/git/commits/{sha}              → base tree SHA
  3. POST /repos/{owner}/{repo}/git/blobs   (parallel, only for binary files)
  4. POST /repos/{owner}/{repo}/git/trees   (UTF-8 text inlined here)
  5. POST /repos/{owner}/{repo}/git/commits
  6. PATCH /repos/{owner}/{repo}/git/refs/heads/{branch}

Steps 1, 2, 4, 5, 6 run sequentially (each depends on the previous).
Step 3 fans out concurrently — 50 binary files = 50 parallel blob POSTs,
not 50 sequential ones.

Auth
----
Reads the token from (in order):
  - ``GITHUB_PERSONAL_ACCESS_TOKEN`` (matches the official GitHub MCP server)
  - ``GITHUB_TOKEN`` (fallback)
"""

from __future__ import annotations

import asyncio
import base64
import logging
import os
import sys
from typing import Any

import httpx
from mcp.server.fastmcp import FastMCP

logger = logging.getLogger("github_batch_mcp")

GITHUB_API = "https://api.github.com"
DEFAULT_TIMEOUT = 60.0

mcp = FastMCP("github-batch")


def _token() -> str:
    tok = os.environ.get("GITHUB_PERSONAL_ACCESS_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if not tok:
        raise RuntimeError(
            "No GitHub token found. Set GITHUB_PERSONAL_ACCESS_TOKEN or GITHUB_TOKEN."
        )
    return tok


def _headers() -> dict[str, str]:
    return {
        "Authorization": f"Bearer {_token()}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "github-batch-mcp/0.1",
    }


def _is_utf8_text(content: str | bytes) -> bool:
    """True if content is a str (or UTF-8-decodable bytes) with no NULs."""
    if isinstance(content, str):
        return "\x00" not in content
    try:
        decoded = content.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return "\x00" not in decoded


async def _create_blob(client: httpx.AsyncClient, owner: str, repo: str,
                       content_b64: str) -> str:
    """POST a base64-encoded blob; return its SHA."""
    r = await client.post(
        f"{GITHUB_API}/repos/{owner}/{repo}/git/blobs",
        json={"content": content_b64, "encoding": "base64"},
        headers=_headers(),
    )
    r.raise_for_status()
    return r.json()["sha"]


async def _batch_commit_impl(
    *,
    owner: str,
    repo: str,
    branch: str,
    message: str,
    files: list[dict[str, Any]],
    delete_paths: list[str] | None = None,
    author_name: str | None = None,
    author_email: str | None = None,
) -> dict[str, Any]:
    files = files or []
    delete_paths = delete_paths or []
    if not files and not delete_paths:
        raise ValueError("batch_commit: nothing to do (files and delete_paths both empty)")

    async with httpx.AsyncClient(timeout=DEFAULT_TIMEOUT) as client:
        # ── 1. Resolve branch HEAD ──
        r = await client.get(
            f"{GITHUB_API}/repos/{owner}/{repo}/git/refs/heads/{branch}",
            headers=_headers(),
        )
        r.raise_for_status()
        head_commit_sha = r.json()["object"]["sha"]

        # ── 2. Resolve base tree ──
        r = await client.get(
            f"{GITHUB_API}/repos/{owner}/{repo}/git/commits/{head_commit_sha}",
            headers=_headers(),
        )
        r.raise_for_status()
        base_tree_sha = r.json()["tree"]["sha"]

        # ── 3. Build tree entries; upload binary blobs in parallel ──
        tree_entries: list[dict[str, Any]] = []
        binary_uploads: list[tuple[int, asyncio.Task]] = []  # (tree_idx, task)

        for f in files:
            path = f.get("path")
            if not path:
                raise ValueError("Each file entry must have a 'path'")
            content = f.get("content", "")
            encoding = f.get("encoding", "utf-8")  # 'utf-8' or 'base64'
            mode = f.get("mode", "100644")

            if encoding == "base64":
                # Caller already base64-encoded a binary file — upload as blob
                idx = len(tree_entries)
                tree_entries.append({
                    "path": path, "mode": mode, "type": "blob", "sha": None,
                })
                binary_uploads.append((
                    idx,
                    asyncio.create_task(_create_blob(client, owner, repo, content)),
                ))
            elif encoding == "utf-8":
                if _is_utf8_text(content):
                    # Inline directly — GitHub auto-creates the blob
                    tree_entries.append({
                        "path": path, "mode": mode, "type": "blob",
                        "content": content,
                    })
                else:
                    # Caller said utf-8 but content isn't — auto-upgrade to base64
                    raw = content.encode("utf-8", errors="surrogateescape") \
                        if isinstance(content, str) else content
                    b64 = base64.b64encode(raw).decode("ascii")
                    idx = len(tree_entries)
                    tree_entries.append({
                        "path": path, "mode": mode, "type": "blob", "sha": None,
                    })
                    binary_uploads.append((
                        idx,
                        asyncio.create_task(_create_blob(client, owner, repo, b64)),
                    ))
            else:
                raise ValueError(f"Unsupported encoding {encoding!r} for {path}")

        for path in delete_paths:
            # sha=null on a tree entry tells GitHub to delete that path
            tree_entries.append({
                "path": path, "mode": "100644", "type": "blob", "sha": None,
            })

        # Wait for all blob uploads and patch their SHAs back in
        if binary_uploads:
            results = await asyncio.gather(
                *(t for _, t in binary_uploads), return_exceptions=True,
            )
            for (idx, _task), res in zip(binary_uploads, results):
                if isinstance(res, BaseException):
                    raise res
                tree_entries[idx]["sha"] = res

        # ── 4. Create the new tree ──
        r = await client.post(
            f"{GITHUB_API}/repos/{owner}/{repo}/git/trees",
            json={"base_tree": base_tree_sha, "tree": tree_entries},
            headers=_headers(),
        )
        r.raise_for_status()
        new_tree_sha = r.json()["sha"]

        # ── 5. Create the commit ──
        commit_body: dict[str, Any] = {
            "message": message,
            "tree": new_tree_sha,
            "parents": [head_commit_sha],
        }
        if author_name and author_email:
            commit_body["author"] = {"name": author_name, "email": author_email}
        r = await client.post(
            f"{GITHUB_API}/repos/{owner}/{repo}/git/commits",
            json=commit_body, headers=_headers(),
        )
        r.raise_for_status()
        new_commit_sha = r.json()["sha"]

        # ── 6. Move the branch ref ──
        r = await client.patch(
            f"{GITHUB_API}/repos/{owner}/{repo}/git/refs/heads/{branch}",
            json={"sha": new_commit_sha, "force": False},
            headers=_headers(),
        )
        r.raise_for_status()

        return {
            "commit_sha": new_commit_sha,
            "tree_sha": new_tree_sha,
            "commit_url": f"https://github.com/{owner}/{repo}/commit/{new_commit_sha}",
            "files_committed": len(files),
            "files_deleted": len(delete_paths),
            "binary_blobs_uploaded": len(binary_uploads),
        }


@mcp.tool()
async def batch_commit(
    owner: str,
    repo: str,
    branch: str,
    message: str,
    files: list[dict[str, Any]] | None = None,
    delete_paths: list[str] | None = None,
    author_name: str | None = None,
    author_email: str | None = None,
) -> dict[str, Any]:
    """Commit many files (and/or deletions) to a GitHub branch in a single commit.

    Uses GitHub's git-data API for O(1) API calls regardless of file count
    (5 sequential calls + N parallel blob uploads for binary files only).

    Args:
        owner: Repository owner (user or org).
        repo: Repository name.
        branch: Target branch (e.g. ``"main"``). Must already exist.
        message: Commit message.
        files: List of file entries. Each entry::

            {
                "path": "src/foo.py",       # required, repo-relative
                "content": "print('hi')",   # required (str or base64 str)
                "encoding": "utf-8",        # optional: "utf-8" (default) or "base64"
                "mode": "100644"            # optional: 100644 file, 100755 exec
            }

          UTF-8 text is inlined into the tree-create call (no extra round-trip).
          Binary files (``encoding="base64"``) are uploaded as blobs in parallel.
        delete_paths: Optional list of repo-relative paths to delete in the
            same commit.
        author_name: Optional commit author override.
        author_email: Optional commit author email override.

    Returns:
        ``{"commit_sha": ..., "commit_url": ..., "files_committed": N,
           "files_deleted": M, "binary_blobs_uploaded": K}``
    """
    return await _batch_commit_impl(
        owner=owner, repo=repo, branch=branch, message=message,
        files=files or [], delete_paths=delete_paths or [],
        author_name=author_name, author_email=author_email,
    )


@mcp.tool()
async def batch_delete(
    owner: str,
    repo: str,
    branch: str,
    message: str,
    paths: list[str],
) -> dict[str, Any]:
    """Delete many files from a branch in a single commit.

    Args:
        owner: Repository owner.
        repo: Repository name.
        branch: Target branch.
        message: Commit message.
        paths: Repo-relative paths to delete.
    """
    if not paths:
        raise ValueError("batch_delete: paths must be non-empty")
    return await _batch_commit_impl(
        owner=owner, repo=repo, branch=branch, message=message,
        files=[], delete_paths=paths,
    )


def main() -> None:
    """Entry point for the ``github-batch-mcp`` script."""
    logging.basicConfig(
        level=os.environ.get("GITHUB_BATCH_MCP_LOG", "INFO"),
        stream=sys.stderr,
        format="[github-batch-mcp] %(levelname)s %(message)s",
    )
    mcp.run()


if __name__ == "__main__":
    main()
