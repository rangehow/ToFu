#!/bin/bash
# PostgreSQL management script for Tofu
# Usage: ./scripts/pg_ctl.sh {start|stop|status|restart}

PGDATA="$(cd "$(dirname "$0")/.." && pwd)/data/pgdata"
LOGFILE="$(cd "$(dirname "$0")/.." && pwd)/logs/postgresql.log"
PG_PORT=${TOFU_PG_PORT:-${CHATUI_PG_PORT:-15432}}
# DB name: live deployments still use 'chatui'; honour TOFU_PG_DBNAME / CHATUI_PG_DBNAME override.
PG_DBNAME=${TOFU_PG_DBNAME:-${CHATUI_PG_DBNAME:-chatui}}

case "$1" in
    start)
        echo "Starting PostgreSQL (port $PG_PORT, data: $PGDATA)..."
        pg_ctl -D "$PGDATA" -l "$LOGFILE" start
        sleep 1
        pg_isready -p $PG_PORT
        ;;
    stop)
        echo "Stopping PostgreSQL..."
        pg_ctl -D "$PGDATA" -m fast stop
        ;;
    restart)
        echo "Restarting PostgreSQL..."
        pg_ctl -D "$PGDATA" -m fast restart -l "$LOGFILE"
        sleep 1
        pg_isready -p $PG_PORT
        ;;
    status)
        pg_ctl -D "$PGDATA" status
        echo ""
        pg_isready -p $PG_PORT
        echo ""
        echo "Database size:"
        psql -p $PG_PORT -d "$PG_DBNAME" -c "SELECT pg_size_pretty(pg_database_size('$PG_DBNAME'));"
        echo ""
        echo "Table sizes:"
        psql -p $PG_PORT -d "$PG_DBNAME" -c "
            SELECT tablename, 
                   pg_size_pretty(pg_total_relation_size(tablename::text)) as size,
                   (SELECT count(*) FROM (SELECT 1 FROM pg_catalog.pg_class c 
                    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace 
                    WHERE c.relname = tablename LIMIT 1) x) as exists
            FROM pg_tables 
            WHERE schemaname = 'public' 
            ORDER BY pg_total_relation_size(tablename::text) DESC
            LIMIT 15;
        "
        ;;
    backup)
        echo "Backing up PostgreSQL database..."
        BACKUP_FILE="$(cd "$(dirname "$0")/.." && pwd)/data/tofu_pg_backup.sql"
        pg_dump -p $PG_PORT "$PG_DBNAME" > "$BACKUP_FILE"
        ls -lh "$BACKUP_FILE"
        echo "Backup saved to: $BACKUP_FILE"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|backup}"
        exit 1
        ;;
esac
