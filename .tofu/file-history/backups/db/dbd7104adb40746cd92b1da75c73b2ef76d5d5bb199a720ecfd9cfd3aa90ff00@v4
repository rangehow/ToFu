# server.py — 全局兜底限流
@app.before_request
def global_rate_limit():
    """全局限流: 每 IP 每分钟最多 120 个请求"""
    if request.path.startswith('/static/'):
        return None
    ip = request.headers.get('X-Forwarded-For', request.remote_addr).split(',')[0].strip()
    key = f"global:{ip}"
    now = time.time()
    hits = [t for t in _global_store.get(key, []) if now - t < 60]
    if len(hits) >= 120:
        return jsonify({'error': 'Too many requests'}), 429
    hits.append(now)
    _global_store[key] = hits
```

