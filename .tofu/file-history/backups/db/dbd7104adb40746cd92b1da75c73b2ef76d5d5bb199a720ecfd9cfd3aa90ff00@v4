```

**风险**: 
1. **SVG XSS** — 允许 `.svg` 上传，SVG 可包含 `<script>` 标签实现 XSS 攻击
2. 仅检查扩展名，未验证 MIME type / magic bytes，可上传伪装文件
3. 无文件大小单独限制（仅依赖全局 16MB）

**修复建议**:

```python
import imghdr

ALLOWED_EXTENSIONS = {'.png', '.jpg', '.jpeg', '.gif', '.webp'}
MAX_IMAGE_SIZE = 5 * 1024 * 1024  # 5MB

@common_bp.route('/api/images/upload', methods=['POST'])
def upload_image():
    file = request.files.get('file')
    if not file or file.filename == '':
        return jsonify({'error': 'No file'}), 400
    
    ext = os.path.splitext(file.filename)[1].lower()
    if ext not in ALLOWED_EXTENSIONS:  # ← 移除 .svg
        return jsonify({'error': f'Unsupported format: {ext}'}), 400
    
    data = file.read()
    if len(data) > MAX_IMAGE_SIZE:
        return jsonify({'error': 'File too large (max 5MB)'}), 400
    
    # 验证真实图片类型
    img_type = imghdr.what(None, h=data)
    if img_type not in ('png', 'jpeg', 'gif', 'webp'):
        return jsonify({'error': 'Invalid image data'}), 400
    
    name = f'{uuid.uuid4().hex}{ext}'
    path = os.path.join(UPLOAD_DIR, name)
    with open(path, 'wb') as f:
        f.write(data)
    return jsonify({'url': f'/api/images/{name}', 'filename': name})
```

