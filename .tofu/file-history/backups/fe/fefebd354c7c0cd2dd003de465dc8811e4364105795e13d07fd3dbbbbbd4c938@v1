/* ═══════════════════════════════════════════════════════════════════
   context-bar.js — Tofu Context Health Bar

   A live indicator on the left flank of .chat-wrapper that shows the
   current conversation's prompt-token usage as a percentage of the
   active model's context window.

   Three per-theme visual variants:
     • dark  — Aurora reactor core (glass capsule, aurora gradient fill)
     • light — Linear pill gauge   (clean white pill, indigo fill)
     • tofu  — Pixel tofu stack    (12 stacked claymorphic tofu cells)

   Public API:
     window.updateContextBar(opts?)  — recompute + repaint the bar.
     Called from:
       - main.js: _applyModelUI, _restoreConvToolState, newChat, loadConversation
       - ui.js:   every assistantMsg.usage write site
   ═══════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  /* ── Model → context-window table.  Mirrors lib/tasks_pkg/compaction.py
   *    _get_context_limit() so client-side estimates match server-side
   *    compaction triggers.  Order matters: more-specific keys first. */
  const _CONTEXT_LIMITS = [
    /* Claude 4.6+ Opus / Sonnet ship with 1M context (GA 2026-03-13). */
    [/(?:claude|anthropic).*opus[-_.]?(\d+)[-_.](\d+)/i, (m) =>
      (parseInt(m[1], 10) >= 4 && parseInt(m[2], 10) >= 6) || parseInt(m[1], 10) > 4 ? 1_000_000 : 200_000],
    [/(?:claude|anthropic).*sonnet[-_.]?(\d+)[-_.](\d+)/i, (m) =>
      (parseInt(m[1], 10) >= 4 && parseInt(m[2], 10) >= 6) || parseInt(m[1], 10) > 4 ? 1_000_000 : 200_000],
    [/claude-opus-4\.6|claude-sonnet-4\.6/i, 1_000_000],
    [/claude/i, 200_000],
    [/gpt-4o|gpt-4-turbo/i, 128_000],
    [/gpt-4|gpt-3\.5/i, 128_000],
    [/o1|o3|o4/i, 200_000],
    [/gemini/i, 1_000_000],
    [/qwen/i, 128_000],
    [/deepseek/i, 128_000],
    [/doubao/i, 128_000],
    [/minimax/i, 1_000_000],
  ];
  const _DEFAULT_LIMIT = 200_000;

  /* ── 82 % matches lib/tasks_pkg/compaction.py _SUMMARY_TRIGGER_RATIO.
   *    Once we cross this, the server is about to summary-compact on the
   *    next call, so we hint that visually. */
  const _COMPACT_THRESHOLD = 0.82;
  const _CRIT_THRESHOLD    = 0.95;

  function _resolveContextLimit(modelId) {
    if (!modelId) return _DEFAULT_LIMIT;
    for (const [re, val] of _CONTEXT_LIMITS) {
      const m = modelId.match(re);
      if (!m) continue;
      return typeof val === 'function' ? val(m) : val;
    }
    return _DEFAULT_LIMIT;
  }

  function _activeConv() {
    if (typeof conversations === 'undefined' || !Array.isArray(conversations)) return null;
    if (typeof activeConvId === 'undefined' || !activeConvId) return null;
    return conversations.find((c) => c && c.id === activeConvId) || null;
  }

  function _activeModel(conv) {
    if (conv && conv.model) return conv.model;
    if (typeof config !== 'undefined' && config && config.model) return config.model;
    if (typeof serverModel !== 'undefined' && serverModel) return serverModel;
    return '';
  }

  /* Read total prompt tokens from the most recent assistant message that has usage. */
  function _lastUsageTokens(conv) {
    if (!conv || !Array.isArray(conv.messages)) return 0;
    for (let i = conv.messages.length - 1; i >= 0; i--) {
      const m = conv.messages[i];
      if (!m || m.role !== 'assistant' || !m.usage) continue;
      const u = m.usage;
      const inp = u.prompt_tokens || u.input_tokens || 0;
      const cw  = u.cache_write_tokens || u.cache_creation_input_tokens || 0;
      const cr  = u.cache_read_tokens  || u.cache_read_input_tokens  || 0;
      /* Anthropic convention: prompt_tokens is uncached residual only.
       * Detection mirrors ui.js:1853 — when inp <= cw+cr and cache > 0,
       * the API returned uncached-only and total = inp + cw + cr. */
      if ((cw > 0 || cr > 0) && inp <= cw + cr) return inp + cw + cr;
      return inp;
    }
    return 0;
  }

  function _formatTokens(n) {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1) + 'M';
    if (n >= 1_000)     return (n / 1_000).toFixed(n >= 10_000 ? 0 : 1) + 'k';
    return String(n);
  }

  /* ── Pixel tofu cube cell (used by the tofu variant only).
   *    Rendered as a tiny SVG so the fill state can be CSS-driven. */
  function _tofuCell(filled) {
    /* Two-layer trick:
     *   .ctx-tofu-cell-bg = empty cell (always visible)
     *   .ctx-tofu-cell-fill = filled overlay, CSS controls clip-path/opacity */
    return (
      '<span class="ctx-tofu-cell' + (filled ? ' filled' : '') + '">' +
        '<span class="ctx-tofu-cell-face"></span>' +
        '<span class="ctx-tofu-cell-shine"></span>' +
      '</span>'
    );
  }

  const _TOFU_CELL_COUNT = 12;

  function _ensureBar() {
    let el = document.getElementById('contextHealthBar');
    if (el) return el;
    const wrapper = document.querySelector('.chat-wrapper');
    if (!wrapper) return null;
    el = document.createElement('aside');
    el.id = 'contextHealthBar';
    el.className = 'ctx-health-bar';
    el.setAttribute('aria-label', 'Context usage');
    el.innerHTML =
      '<div class="ctx-bar-rail">' +
        '<div class="ctx-bar-fill"></div>' +
        '<div class="ctx-bar-tofu-stack" aria-hidden="true"></div>' +
      '</div>' +
      '<div class="ctx-bar-pct" data-role="pct">0%</div>' +
      '<div class="ctx-bar-cap" data-role="cap">—</div>';
    wrapper.appendChild(el);
    /* Click toggles a compact / expanded view. */
    el.addEventListener('click', () => {
      el.classList.toggle('ctx-collapsed');
    });
    return el;
  }

  let _scheduled = false;

  function updateContextBar() {
    /* Coalesce bursty updates — multiple SSE events in the same tick get one repaint. */
    if (_scheduled) return;
    _scheduled = true;
    requestAnimationFrame(() => {
      _scheduled = false;
      _doUpdate();
    });
  }

  function _doUpdate() {
    const el = _ensureBar();
    if (!el) return;
    const conv  = _activeConv();
    const model = _activeModel(conv);
    const limit = _resolveContextLimit(model);
    const used  = _lastUsageTokens(conv);
    const pct   = limit > 0 ? Math.min(1, used / limit) : 0;
    const pctRounded = Math.round(pct * 100);

    /* Zone classification: ok < 60 % < warn < 82 % ≤ hot < 95 % ≤ crit. */
    let zone = 'ok';
    if      (pct >= _CRIT_THRESHOLD)    zone = 'crit';
    else if (pct >= _COMPACT_THRESHOLD) zone = 'hot';
    else if (pct >= 0.60)               zone = 'warn';
    el.dataset.zone = zone;

    /* CSS custom properties drive every visual. */
    el.style.setProperty('--ctx-fill', pct.toFixed(4));
    el.style.setProperty('--ctx-fill-pct', (pct * 100).toFixed(2) + '%');

    const pctNode = el.querySelector('[data-role="pct"]');
    const capNode = el.querySelector('[data-role="cap"]');
    if (pctNode) pctNode.textContent = used > 0 ? pctRounded + '%' : '—';
    if (capNode) capNode.textContent = _formatTokens(limit);

    /* Tofu stack: rebuild only when filled-cell count changes (cheap). */
    const stack = el.querySelector('.ctx-bar-tofu-stack');
    if (stack) {
      const filled = Math.round(pct * _TOFU_CELL_COUNT);
      const prev = parseInt(stack.dataset.filled || '-1', 10);
      if (prev !== filled) {
        stack.dataset.filled = String(filled);
        let html = '';
        /* Render top-to-bottom; the topmost cells fill last. */
        for (let i = _TOFU_CELL_COUNT - 1; i >= 0; i--) {
          html += _tofuCell(i < filled);
        }
        stack.innerHTML = html;
      }
    }

    /* Tooltip: full breakdown for hover. */
    const modelLabel = model || 'unknown';
    const tip = used > 0
      ? modelLabel + '\n' + _formatTokens(used) + ' / ' + _formatTokens(limit) +
        ' tokens (' + pctRounded + '%)' +
        (zone === 'hot'  ? '\nApproaching auto-compact threshold' : '') +
        (zone === 'crit' ? '\nCritical — compaction imminent'      : '')
      : modelLabel + '\nContext window: ' + _formatTokens(limit) + ' tokens';
    el.title = tip;
  }

  /* Public hooks. */
  window.updateContextBar = updateContextBar;
  window._resolveContextLimit = _resolveContextLimit;  /* exported for debug */

  /* Initial paint as soon as the DOM is ready. */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateContextBar, { once: true });
  } else {
    updateContextBar();
  }
})();
