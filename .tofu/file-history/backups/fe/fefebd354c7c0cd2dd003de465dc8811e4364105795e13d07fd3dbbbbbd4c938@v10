/* ═══════════════════════════════════════════════════════════════════
   context-bar.js — Tofu Context Health Bar

   A small status chip in the bottom-left corner of .chat-wrapper that
   shows the current conversation's prompt-token usage as a percentage
   of the active model's context window.

   Single geometry across all themes: a 28-px conic-gradient ring with
   a tiny tofu cube in the center, percentage label beside it, and a
   secondary token-cap label.  Per-theme palettes only.  No motion
   except the arc length growing on actual value change.

   ── Anti-flicker invariants (DO NOT regress) ──
   1. Every node is CREATED ONCE in `_ensureBar()` and cached on the
      element via `_state`.  Subsequent updates only set CSS custom
      properties / set `textContent` / set `dataset.zone`.  NO
      `innerHTML` rebuilds, NO `appendChild`/`removeChild` on the hot
      path.  The original module had the wrong shape and caused
      flicker on every SSE usage write — see
      `renderChat-surgical-dom-update-scroll-fix` for the same lesson
      applied to the chat list.
   2. Property writes are no-ops if the value is unchanged.
   3. No idle CSS animation loops.  The only motion is the conic
      gradient's arc length growing on actual value change, animated
      via the `--ctx-arc-pct` `@property` transition.
   4. No `@media` opacity rules.  The chip stays at full opacity at
      every desktop width (>900 px); below 900 px it's hidden.

   Public API:
     window.updateContextBar()     — recompute + repaint (rAF-coalesced).
     window._resolveContextLimit() — exported for debug.
   ═══════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  /* ── Model → context-window table.  Mirrors lib/tasks_pkg/compaction.py
   *    `_get_context_limit()` so client-side estimates match server-side
   *    compaction triggers.  Order matters: more-specific keys first. */
  const _CONTEXT_LIMITS = [
    /* Claude 4.6+ Opus / Sonnet ship with 1M context (GA 2026-03-13). */
    [/(?:claude|anthropic).*opus[-_.]?(\d+)[-_.](\d+)/i, (m) =>
      (parseInt(m[1], 10) >= 4 && parseInt(m[2], 10) >= 6) || parseInt(m[1], 10) > 4 ? 1_000_000 : 200_000],
    [/(?:claude|anthropic).*sonnet[-_.]?(\d+)[-_.](\d+)/i, (m) =>
      (parseInt(m[1], 10) >= 4 && parseInt(m[2], 10) >= 6) || parseInt(m[1], 10) > 4 ? 1_000_000 : 200_000],
    [/claude-opus-4\.6|claude-sonnet-4\.6/i, 1_000_000],
    [/claude/i, 200_000],
    [/gpt-4o|gpt-4-turbo/i, 128_000],
    [/gpt-4|gpt-3\.5/i, 128_000],
    [/o1|o3|o4/i, 200_000],
    [/gemini/i, 1_000_000],
    [/qwen/i, 128_000],
    [/deepseek/i, 128_000],
    [/doubao/i, 128_000],
    [/minimax/i, 1_000_000],
  ];
  const _DEFAULT_LIMIT = 200_000;

  /* 82 % matches lib/tasks_pkg/compaction.py:_SUMMARY_TRIGGER_RATIO —
   * once we cross this, the server compacts on the next call. */
  const _COMPACT_THRESHOLD = 0.82;
  const _CRIT_THRESHOLD    = 0.95;

  function _resolveContextLimit(modelId) {
    if (!modelId) return _DEFAULT_LIMIT;
    for (const [re, val] of _CONTEXT_LIMITS) {
      const m = modelId.match(re);
      if (!m) continue;
      return typeof val === 'function' ? val(m) : val;
    }
    return _DEFAULT_LIMIT;
  }

  function _activeConv() {
    if (typeof conversations === 'undefined' || !Array.isArray(conversations)) return null;
    if (typeof activeConvId === 'undefined' || !activeConvId) return null;
    return conversations.find((c) => c && c.id === activeConvId) || null;
  }

  function _activeModel(conv) {
    if (conv && conv.model) return conv.model;
    if (typeof config !== 'undefined' && config && config.model) return config.model;
    if (typeof serverModel !== 'undefined' && serverModel) return serverModel;
    return '';
  }

  /* Read total prompt tokens from the most recent assistant msg with usage. */
  function _lastUsageTokens(conv) {
    if (!conv || !Array.isArray(conv.messages)) return 0;
    for (let i = conv.messages.length - 1; i >= 0; i--) {
      const m = conv.messages[i];
      if (!m || m.role !== 'assistant' || !m.usage) continue;
      const u = m.usage;
      const inp = u.prompt_tokens || u.input_tokens || 0;
      const cw  = u.cache_write_tokens || u.cache_creation_input_tokens || 0;
      const cr  = u.cache_read_tokens  || u.cache_read_input_tokens  || 0;
      /* Anthropic convention: prompt_tokens is uncached residual only.
       * Mirrors ui.js:1853 — when inp <= cw+cr and cache > 0, total is
       * inp + cw + cr; otherwise (OpenAI convention) inp is already total. */
      if ((cw > 0 || cr > 0) && inp <= cw + cr) return inp + cw + cr;
      return inp;
    }
    return 0;
  }

  function _formatTokens(n) {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1) + 'M';
    if (n >= 1_000)     return (n / 1_000).toFixed(n >= 10_000 ? 0 : 1) + 'k';
    return String(n);
  }

  /* Static SVG of a tiny tofu cube — used as the icon above the gauge.
   * Drawn once into the DOM, not regenerated. */
  const _TOFU_ICON_SVG =
    '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">' +
      '<path d="M3 5l5-2.5 5 2.5v6l-5 2.5L3 11z" fill="var(--ctx-icon-top, #f5e7c8)"/>' +
      '<path d="M3 5l5 2.5v6L3 11z" fill="var(--ctx-icon-side, #e0cfa6)"/>' +
      '<path d="M8 7.5l5-2.5v6l-5 2.5z" fill="var(--ctx-icon-front, #d4be8e)"/>' +
      '<path d="M3 5l5-2.5 5 2.5-5 2.5z" fill="none" stroke="var(--ctx-icon-edge, rgba(80,55,20,0.4))" stroke-width=".4"/>' +
    '</svg>';

  /* ── _state: per-bar cached node references, populated by `_ensureBar`.
   *    Hot-path updates only touch these — no new DOM is ever created. */
  let _state = null;

  function _ensureBar() {
    if (_state && _state.el && _state.el.isConnected) return _state;
    const existing = document.getElementById('contextHealthBar');
    if (existing && _state && _state.el === existing) return _state;
    const wrapper = document.querySelector('.chat-wrapper');
    if (!wrapper) return null;
    const el = existing || document.createElement('aside');
    if (!existing) {
      el.id = 'contextHealthBar';
      el.className = 'ctx-health-bar';
      el.setAttribute('aria-label', 'Context usage');
      wrapper.appendChild(el);
    }
    /* One-shot DOM build — never rebuilt on hot path.
     *
     * Geometry: a small chip with a 28-px conic-gradient ring (donut),
     * a tiny tofu cube glyph in the donut hole, and "34%" / "1M" text
     * to the right.  The legacy fill / fill-head / ticks / cell-stack
     * nodes from the older HP-bar variants are no longer rendered.
     * (CSS `display:none` would also work for those, but omitting them
     * from the DOM keeps the tree small.) */
    el.innerHTML =
      '<div class="ctx-bar-rail">' +
        '<div class="ctx-bar-icon" aria-hidden="true">' + _TOFU_ICON_SVG + '</div>' +
      '</div>' +
      '<div class="ctx-bar-pct">0%</div>' +
      '<div class="ctx-bar-cap">—</div>';
    _state = {
      el,
      railNode: el.querySelector('.ctx-bar-rail'),
      pctNode: el.querySelector('.ctx-bar-pct'),
      capNode: el.querySelector('.ctx-bar-cap'),
      lastZone: '',
      lastPctText: '',
      lastCapText: '',
      lastTitle: '',
      lastFillPct: -1,
    };
    return _state;
  }

  let _scheduled = false;

  function updateContextBar() {
    if (_scheduled) return;
    _scheduled = true;
    requestAnimationFrame(() => {
      _scheduled = false;
      _doUpdate();
    });
  }

  function _doUpdate() {
    const s = _ensureBar();
    if (!s) return;
    const conv  = _activeConv();
    const model = _activeModel(conv);
    const limit = _resolveContextLimit(model);
    const used  = _lastUsageTokens(conv);
    const pct   = limit > 0 ? Math.min(1, used / limit) : 0;
    const pctRounded = Math.round(pct * 100);

    let zone = 'ok';
    if      (pct >= _CRIT_THRESHOLD)    zone = 'crit';
    else if (pct >= _COMPACT_THRESHOLD) zone = 'hot';
    else if (pct >= 0.60)               zone = 'warn';

    /* ── Surgical writes: only touch the DOM when a value actually changed. */
    if (s.lastZone !== zone) {
      s.el.dataset.zone = zone;
      s.lastZone = zone;
    }
    if (s.lastFillPct !== pct) {
      /* The CSS uses --ctx-arc-pct on the .ctx-bar-rail itself.  Setting it
       * on the rail (not the host) lets the @property transition animate. */
      s.railNode.style.setProperty('--ctx-arc-pct', (pct * 100).toFixed(2) + '%');
      s.lastFillPct = pct;
    }

    const pctText = used > 0 ? pctRounded + '%' : '—';
    if (s.lastPctText !== pctText) {
      s.pctNode.textContent = pctText;
      s.lastPctText = pctText;
    }
    const capText = _formatTokens(limit);
    if (s.lastCapText !== capText) {
      s.capNode.textContent = capText;
      s.lastCapText = capText;
    }

    const modelLabel = model || 'unknown';
    const tip = used > 0
      ? modelLabel + '\n' + _formatTokens(used) + ' / ' + capText +
        ' tokens (' + pctRounded + '%)' +
        (zone === 'hot'  ? '\nApproaching auto-compact threshold' : '') +
        (zone === 'crit' ? '\nCritical — compaction imminent'      : '')
      : modelLabel + '\nContext window: ' + capText + ' tokens';
    if (s.lastTitle !== tip) {
      s.el.title = tip;
      s.lastTitle = tip;
    }
  }

  window.updateContextBar = updateContextBar;
  window._resolveContextLimit = _resolveContextLimit;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateContextBar, { once: true });
  } else {
    updateContextBar();
  }
})();
