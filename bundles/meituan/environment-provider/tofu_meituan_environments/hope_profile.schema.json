{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner_id",
    "tenant_id",
    "projects",
    "profile",
    "artifact_profile",
    "expected_creator",
    "environment",
    "mcp_timeout_seconds",
    "output_timeout_seconds"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "maxLength": 128
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object"
    },
    "artifact_profile": {
      "type": "object",
      "properties": {
        "parallel_upload": {
          "type": "object",
          "required": [
            "jar_path",
            "sha256",
            "threshold_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "jar_path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "threshold_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "expected_creator": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mcp_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "output_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
