; desktop/installer.nsi.tmpl — server-side Windows installer authoring (NSIS).
; ─────────────────────────────────────────────────────────────────────────
; Why NSIS and not Inno (the CI's tool), measured 2026-08-01 on the
; server-side build box (epic pt_ce426157):
;   * iscc must run under our userspace Wine (no cross-build server) — but
;     EVERY 32-bit Windows app measured (Inno's own installer, innounp)
;     HANGS under the new WoW64 without the preloader (seccomp SIGSYS);
;     64-bit apps work. Inno 6's iscc is 32-bit, and the Inno 7 x64
;     installer (our only way to get a 64-bit iscc) is itself 32-bit-hosted
;     and hangs. Extraction without the installer fails too (7-Zip 23.01
;     cannot read Inno 7's container).
;   * makensis runs NATIVELY on Linux (conda-forge nsis): no wine, no
;     display, deterministic. That determinism is what a release pipeline
;     needs most.
; The CI keeps its Inno authoring (.github/workflows/build-desktop.yml).
; The two authorings are bound by tests/test_installer_parity.py, which
; asserts they agree on the semantic contract (app name, install dir,
; privilege level, shortcuts, launch-after-install, output name, payload
; contents, wizard assets, preseed file). The contract — not the tool —
; is the single source of truth.
;
; Placeholders (rendered by lib/desktop_dist/winbuilder.py::_render_nsi):
;   @APP_VERSION@   e.g. 0.16.0
;   @PAYLOAD_DIR@   absolute path of the unpacked payload (contains Tofu.exe
;                   and, when pre-seeded, preseed_server.json)
;   @OUT_FILE@      absolute output path for the .exe
;   @ASSET_DIR@     repo static/icons dir (icon + wizard bitmap)
; ─────────────────────────────────────────────────────────────────────────

!define APP_NAME      "Tofu"
!define APP_VERSION   "@APP_VERSION@"
!define PUBLISHER     "Tofu Project"
!define APP_EXE       "Tofu.exe"

!include "MUI2.nsh"

Name "${APP_NAME}"
OutFile "@OUT_FILE@"
Unicode True
RequestExecutionLevel user          ; per-user install, no UAC — the Inno
                                    ; authoring's PrivilegesRequired=lowest
InstallDir "$LOCALAPPDATA\Programs\Tofu"
ShowInstDetails show

; ── Branding (shared assets with the Inno authoring) ──
!define MUI_ICON   "@ASSET_DIR@/tofu.ico"
!define MUI_UNICON "@ASSET_DIR@/tofu.ico"
; The welcome/side bitmap has the same 164x314 convention in both tools.
!define MUI_WELCOMEFINISHPAGE_BITMAP "@ASSET_DIR@/installer/wizard-large.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "@ASSET_DIR@/installer/wizard-large.bmp"

!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\${APP_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Launch Tofu"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "SimpChinese"

Section "Install"
  SetOutPath "$INSTDIR"
  ; The whole payload — Tofu.exe, _internal/, and preseed_server.json
  ; when the build pre-seeded one (see desktop/launcher.py's first-run
  ; import; the file lives NEXT TO the exe by contract).
  File /r "@PAYLOAD_DIR@/*"

  ; Shortcuts — same two the Inno authoring creates.
  CreateDirectory "$SMPROGRAMS\Tofu"
  CreateShortcut  "$SMPROGRAMS\Tofu\Tofu.lnk" "$INSTDIR\${APP_EXE}"
  CreateShortcut  "$DESKTOP\Tofu.lnk"         "$INSTDIR\${APP_EXE}"

  WriteUninstaller "$INSTDIR\Uninstall.exe"
SectionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\Tofu\Tofu.lnk"
  RMDir  "$SMPROGRAMS\Tofu"
  Delete "$DESKTOP\Tofu.lnk"
  ; User data is NOT touched: it lives in ~/.local/share/Tofu per the
  ; runtime_paths read-only-exe-dir contract — same rule as the Inno
  ; authoring and the .deb.
  RMDir /r "$INSTDIR"
SectionEnd
