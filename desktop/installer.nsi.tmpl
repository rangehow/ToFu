; desktop/installer.nsi.tmpl — server-side Windows installer authoring (NSIS).
; ─────────────────────────────────────────────────────────────────────────
; Why NSIS and not Inno (the CI's tool), measured 2026-08-01 on the
; server-side build box (epic pt_ce426157):
;   * iscc must run under our userspace Wine (no cross-build server) — but
;     EVERY 32-bit Windows app measured (Inno's own installer, innounp)
;     HANGS under the new WoW64 without the preloader (seccomp SIGSYS);
;     64-bit apps work. Inno 6's iscc is 32-bit, and the Inno 7 x64
;     installer (our only way to get a 64-bit iscc) is itself 32-bit-hosted
;     and hangs. Extraction without the installer fails too (7-Zip 23.01
;     cannot read Inno 7's container).
;   * makensis runs NATIVELY on Linux (conda-forge nsis): no wine, no
;     display, deterministic. That determinism is what a release pipeline
;     needs most.
; The CI keeps its Inno authoring (.github/workflows/build-desktop.yml).
; The two authorings are bound by tests/test_installer_parity.py, which
; asserts they agree on the semantic contract (app name, install dir,
; privilege level, shortcuts, launch-after-install, output name, payload
; contents, wizard assets, preseed file). The contract — not the tool —
; is the single source of truth.
;
; Placeholders (rendered by lib/desktop_dist/winbuilder.py::_render_nsi).
; They are named here WITHOUT their @@ delimiters ON PURPOSE: the
; renderer is a global string replace, and a code-valued placeholder
; (e.g. the autostart SECTION) expanding inside a comment inserts
; section commands outside any Section — makensis aborts. Never write
; an @-delimited token in a comment.
;   APP_VERSION          e.g. 0.16.0
;   PAYLOAD_DIR          absolute path of the unpacked payload (contains the
;                        app exe and, when pre-seeded, preseed_server.json)
;   OUT_FILE             absolute output path for the .exe
;   ASSET_DIR            repo static/icons dir (icon + wizard bitmap)
;   APP_NAME             display name (Tofu / Tofu Agent)
;   APP_EXE              payload exe (Tofu.exe / TofuAgent.exe)
;   INSTALL_DIR_NAME     dir under $LOCALAPPDATA\Programs (Tofu / TofuAgent)
;   COMPONENTS_PAGE      '!insertmacro MUI_PAGE_COMPONENTS' or empty
;   INSTALL_REQUIRED     '  SectionIn RO' or empty (main section uncheckable
;                        when a components page exists)
;   AUTOSTART_SECTION    optional default-ON "Start with Windows" section
;                        (agent only — HKCU Run value, UAC-free per-user)
;   AUTOSTART_UNINSTALL  matching DeleteRegValue, or empty
; ─────────────────────────────────────────────────────────────────────────

!define APP_NAME      "@APP_NAME@"
!define APP_VERSION   "@APP_VERSION@"
!define PUBLISHER     "Tofu Project"
!define APP_EXE       "@APP_EXE@"

!include "MUI2.nsh"

Name "${APP_NAME}"
OutFile "@OUT_FILE@"
Unicode True
RequestExecutionLevel user          ; per-user install, no UAC — the Inno
                                    ; authoring's PrivilegesRequired=lowest
InstallDir "$LOCALAPPDATA\Programs\@INSTALL_DIR_NAME@"
ShowInstDetails show

; ── Branding (shared assets with the Inno authoring) ──
!define MUI_ICON   "@ASSET_DIR@/tofu.ico"
!define MUI_UNICON "@ASSET_DIR@/tofu.ico"
; The welcome/side bitmap has the same 164x314 convention in both tools.
!define MUI_WELCOMEFINISHPAGE_BITMAP "@ASSET_DIR@/installer/wizard-large.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "@ASSET_DIR@/installer/wizard-large.bmp"

!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\${APP_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Launch ${APP_NAME}"

@COMPONENTS_PAGE@
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "SimpChinese"

!include "LogicLib.nsh"

; Bilingual prompt for the running-app guard below.
LangString TOFU_RUNNING_PROMPT 1033 "${APP_NAME} is currently running.$\r$\n$\r$\nChoose Yes to close it automatically and continue, or No to cancel."
LangString TOFU_RUNNING_PROMPT 2052 "${APP_NAME} 正在运行。$\r$\n$\r$\n选择「是」自动关闭并继续，选择「否」取消。"

; ── Running-app guard ──
; A running app locks its exe image, so the payload copy (File /r) used
; to die mid-install on a raw file-in-use Abort/Retry/Ignore box. Probe
; the lock FIRST (an append-mode open of a running image is refused by
; Windows) and offer to close the app FOR the user. Inserted into both
; .onInit (upgrade-over-running) and un.onInit (uninstall-while-running
; would leave a half-deleted dir). Labels stay function-scoped, so the
; two insertions never collide.
!macro TOFU_CLOSE_RUNNING_APP
  ${If} ${FileExists} "$INSTDIR\${APP_EXE}"
    ${Do}
      ClearErrors
      FileOpen $0 "$INSTDIR\${APP_EXE}" a
      ${If} ${Errors}
        MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON1 \
          "$(TOFU_RUNNING_PROMPT)" /SD IDYES \
          IDYES tofu_close_app IDNO tofu_abort_setup
        tofu_abort_setup:
          Abort
        tofu_close_app:
          ; nsExec hides the taskkill console (no black flash); /T takes
          ; the whole tree so the agent's ssh tunnels die with it, /F
          ; forces — a tray agent owns no unsaved document.
          nsExec::Exec 'taskkill /IM ${APP_EXE} /T /F'
          Pop $1
          Sleep 1200
      ${Else}
        FileClose $0
        ${ExitDo}
      ${EndIf}
    ${Loop}
  ${EndIf}
!macroend

Function .onInit
  !insertmacro TOFU_CLOSE_RUNNING_APP
FunctionEnd

Function un.onInit
  !insertmacro TOFU_CLOSE_RUNNING_APP
FunctionEnd

Section "Install"
@INSTALL_REQUIRED@
  SetOutPath "$INSTDIR"
  ; The whole payload — the app exe, _internal/, and preseed_server.json
  ; when the build pre-seeded one (see desktop/launcher.py's first-run
  ; import; the file lives NEXT TO the exe by contract).
  File /r "@PAYLOAD_DIR@/*"

  ; Shortcuts — same two the Inno authoring creates.
  CreateDirectory "$SMPROGRAMS\${APP_NAME}"
  CreateShortcut  "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}"
  CreateShortcut  "$DESKTOP\${APP_NAME}.lnk"                 "$INSTDIR\${APP_EXE}"

  WriteUninstaller "$INSTDIR\Uninstall.exe"
SectionEnd

@AUTOSTART_SECTION@

Section "Uninstall"
  Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk"
  RMDir  "$SMPROGRAMS\${APP_NAME}"
  Delete "$DESKTOP\${APP_NAME}.lnk"
@AUTOSTART_UNINSTALL@
  ; User data is NOT touched: it lives in ~/.local/share/Tofu per the
  ; runtime_paths read-only-exe-dir contract — same rule as the Inno
  ; authoring and the .deb.
  RMDir /r "$INSTDIR"
SectionEnd
